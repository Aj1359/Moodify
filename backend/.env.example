

# ==============================================================================
# Moodify Backend Environment Variables Template
# Copy this file to .env and fill in your real credentials.
# NEVER commit your real .env file or real secrets to git!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain from: https://supabase.com/dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Secret Service Role Key (Bypasses Row Level Security; KEEP PRIVATE on backend only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Public Anon Key
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# AI / LLM Configuration
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-1.5-flash

# Optional: Evaluation delay (ms) for batch benchmark evaluation against free tier rate limits
EVAL_DELAY_MS=4000
RUN_LLM_EVAL=0
