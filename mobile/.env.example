# ==============================================================================
# Moodify Mobile Environment Variables Template
# Copy this file to .env in the mobile folder and fill in your values.
# NEVER commit your real .env file to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain from: https://supabase.com/dashboard -> Project Settings -> API
# Note: Mobile ONLY receives the public Anon key. NEVER put the service-role key here!
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# Backend API Base URL
# - When using iOS Simulator / Android Emulator: http://localhost:5000/api
# - When using physical device with Expo Go: http://<YOUR_COMPUTER_LOCAL_IP>:5000/api
# - When using deployed production backend: https://your-backend.onrender.com/api
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# Offline Mock Mode
# - Set to "true" to test the mobile UI offline with in-memory mock responses
# - Set to "false" to connect to the real backend and Supabase database
# ------------------------------------------------------------------------------
EXPO_PUBLIC_USE_MOCKS=false
