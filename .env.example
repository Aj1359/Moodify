# ==============================================================================
# Moodify Master Environment Variables Reference
# ==============================================================================
# This template lists all environment variables across backend and mobile.
# Each subfolder has its own targeted .env.example:
#   - Backend: backend/.env.example -> backend/.env
#   - Mobile:  mobile/.env.example  -> mobile/.env
#
# NEVER commit your actual .env files or real API keys to git!
# ==============================================================================

# --- BACKEND (backend/.env) ---
# Server
PORT=5000
NODE_ENV=development

# Supabase (Get from: https://supabase.com/dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Gemini AI (Get from: https://aistudio.google.com/app/apikey)
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-1.5-flash

# --- MOBILE (mobile/.env) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api
EXPO_PUBLIC_USE_MOCKS=false
